// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  JUNIOR
  ADOLESCENTES
  JUVENIL
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TEXT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AdminRole {
  ADMIN
  TEACHER
  ADMIN_TEACHER
}

enum StudentProgram {
  ER
  MR
}

enum EventApplicationType {
  BIBLICA_ONLINE
  BIBLICA_ORAL
  ESPORTIVA_PROVA
  ESPORTIVA_JOGOS
  GERAL
}

enum EventLeaderRole {
  CONSELHEIRO
  ORIENTADOR
}

model AdminUser {
  id                  String                    @id @default(cuid())
  name                String
  email               String                    @unique
  passwordHash        String
  sessionVersion      Int                       @default(0)
  mfaEnabled          Boolean                   @default(false)
  mfaSecretEncrypted  String?
  mfaConfirmedAt      DateTime?
  mfaLastUsedStep     Int?
  role                AdminRole                 @default(TEACHER)
  active              Boolean                   @default(true)
  churchId            String?
  church              Church?                   @relation(fields: [churchId], references: [id], onDelete: SetNull)
  passwordResetTokens AdminPasswordResetToken[]
  eventRegistrations  EventRegistration[]       @relation("EventRegistrationLeader")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([role])
  @@index([active])
  @@index([churchId])
  @@index([mfaEnabled])
}

model AdminPasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  requestedIp String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Church {
  id                 String              @id @default(cuid())
  name               String              @unique
  embassyName        String?
  city               String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  students           Student[]
  staffUsers         AdminUser[]
  eventRegistrations EventRegistration[]
}

model Student {
  id                    String                   @id @default(cuid())
  name                  String
  normalizedName        String
  program               StudentProgram           @default(ER)
  category              Category
  externalId            String?
  registrationIssuedAt  DateTime?
  registrationExpiresAt DateTime?
  birthDate             DateTime?
  embassyAdmissionDate  DateTime?
  hasMedicalReport      Boolean                  @default(false)
  extraTimePercent      Int?
  active                Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  churchId              String
  church                Church                   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  participants          ApplicationParticipant[]
  attempts              Attempt[]
  eventRegistrations    EventRegistration[]

  @@unique([churchId, category, normalizedName])
  @@index([program])
  @@index([category])
  @@index([externalId])
}

model Exam {
  id              String            @id @default(cuid())
  title           String
  description     String?
  durationMinutes Int               @default(60)
  passingPercent  Float             @default(70)
  status          ExamStatus        @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  questions       Question[]
  applications    ExamApplication[]
}

model Question {
  id             String       @id @default(cuid())
  examId         String
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  position       Int
  statement      String
  type           QuestionType @default(MULTIPLE_CHOICE)
  points         Float        @default(1)
  category       Category?
  theme          String?
  difficulty     String?
  bibleReference String?
  explanation    String?
  sourceStatus   String?
  active         Boolean      @default(true)
  options        Option[]
  answers        Answer[]

  @@unique([examId, position])
  @@index([category])
  @@index([active])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  label      String
  text       String
  isCorrect  Boolean  @default(false)
  answers    Answer[]

  @@unique([questionId, position])
}

model ExamApplication {
  id                  String                   @id @default(cuid())
  examId              String
  exam                Exam                     @relation(fields: [examId], references: [id], onDelete: Cascade)
  title               String
  program             StudentProgram           @default(ER)
  accessCode          String                   @unique
  active              Boolean                  @default(true)
  startsAt            DateTime?
  endsAt              DateTime?
  purgeAt             DateTime?
  showResultToStudent Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  participants        ApplicationParticipant[]
  attempts            Attempt[]
  eventApplications   EventApplication[]

  @@index([active])
  @@index([program])
  @@index([startsAt])
  @@index([endsAt])
  @@index([purgeAt])
}

model ApplicationParticipant {
  id            String          @id @default(cuid())
  applicationId String
  application   ExamApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@unique([applicationId, studentId])
}

model Event {
  id                            String              @id @default(cuid())
  title                         String
  description                   String?
  active                        Boolean             @default(true)
  startsAt                      DateTime?
  endsAt                        DateTime?
  maxApplicationsPerParticipant Int                 @default(1)
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  applications                  EventApplication[]
  registrations                 EventRegistration[]

  @@index([active])
  @@index([startsAt])
  @@index([endsAt])
}

model EventApplication {
  id            String                        @id @default(cuid())
  eventId       String
  event         Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  applicationId String
  application   ExamApplication               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          EventApplicationType          @default(BIBLICA_ONLINE)
  createdAt     DateTime                      @default(now())
  registrations EventRegistrationAssignment[]

  @@unique([eventId, applicationId])
  @@index([eventId])
  @@index([applicationId])
  @@index([type])
}

model EventRegistration {
  id               String                        @id @default(cuid())
  eventId          String
  event            Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationCode String                        @unique
  studentId        String?
  student          Student?                      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  name             String
  normalizedName   String
  category         Category
  program          StudentProgram                @default(ER)
  birthDate        DateTime?
  churchId         String
  church           Church                        @relation(fields: [churchId], references: [id], onDelete: Restrict)
  leaderUserId     String?
  leaderUser       AdminUser?                    @relation("EventRegistrationLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  leaderName       String
  leaderRole       EventLeaderRole               @default(CONSELHEIRO)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  assignments      EventRegistrationAssignment[]
  attempts         Attempt[]

  @@unique([eventId, studentId])
  @@index([eventId])
  @@index([studentId])
  @@index([churchId])
  @@index([program])
  @@index([registrationCode])
  @@index([leaderUserId])
}

model EventRegistrationAssignment {
  id                 String            @id @default(cuid())
  registrationId     String
  registration       EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventApplicationId String
  eventApplication   EventApplication  @relation(fields: [eventApplicationId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())

  @@unique([registrationId, eventApplicationId])
  @@index([eventApplicationId])
}

model Attempt {
  id                  String             @id @default(cuid())
  applicationId       String
  application         ExamApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentId           String?
  student             Student?           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  eventRegistrationId String?
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: Restrict)
  startedAt           DateTime           @default(now())
  submittedAt         DateTime?
  expiresAt           DateTime
  status              AttemptStatus      @default(IN_PROGRESS)
  score               Float?
  totalPoints         Float?
  timeUsedSeconds     Int?
  answers             Answer[]

  @@unique([applicationId, studentId])
  @@unique([applicationId, eventRegistrationId])
  @@index([status])
  @@index([eventRegistrationId])
}

model Answer {
  id               String   @id @default(cuid())
  attemptId        String
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   Option?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  textAnswer       String?
  isCorrect        Boolean?
  pointsAwarded    Float?
  manualComment    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([attemptId, questionId])
}
